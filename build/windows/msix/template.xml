<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="pvfine"
        Arguments=""
        InstallLocation="C:\Program Files\dof-dev\pvfine">
    </Installer>
    <PackageInformation
        PackageName="pvfine"
        PackageDisplayName="pvfine"
        PublisherName="CN=dof-dev"
        PublisherDisplayName="dof-dev"
        Version="0.2.0.0"
        PackageDescription="PVF 归档编辑器">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.dofdev.pvfine"
                Description="PVF 归档编辑器"
                DisplayName="pvfine"
                ExecutableName="pvfine"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>pvfine</DisplayName>
            <PublisherDisplayName>dof-dev</PublisherDisplayName>
            <Description>PVF 归档编辑器</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="pvfine.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
