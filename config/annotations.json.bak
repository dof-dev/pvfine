{
  "version": 1,
  "description": "pvfine built-in annotation rules",
  "rules": [
    {
      "id": "global.rarity.1",
      "match": {},
      "target": {
        "kind": "section",
        "section": "rarity"
      },
      "annotation": {
        "title": "稀有度",
        "type": "text"
      },
      "group": "global"
    },
    {
      "id": "global.rarity.2",
      "match": {},
      "target": {
        "kind": "token",
        "section": "rarity",
        "index": 0
      },
      "annotation": {
        "title": "稀有度",
        "type": "enum",
        "values": {
          "0": "普通",
          "1": "魔法",
          "2": "稀有",
          "3": "神器",
          "4": "史诗",
          "5": "勇者",
          "6": "传说"
        }
      },
      "group": "global"
    },
    {
      "id": "booster装备关联",
      "match": {
        "extensions": [
          ".stk"
        ]
      },
      "target": {
        "kind": "token",
        "section": "etc",
        "index": 1
      },
      "annotation": {
        "title": "非法 ID",
        "type": "reference",
        "relation": "装备"
      },
      "group": "booster"
    },
    {
      "id": "booster道具关联",
      "match": {
        "extensions": [
          ".stk"
        ]
      },
      "target": {
        "kind": "token",
        "section": "stackable",
        "index": 1
      },
      "annotation": {
        "title": "非法 ID",
        "type": "reference",
        "relation": "道具"
      },
      "group": "booster"
    },
    {
      "id": "booster·道具权重",
      "match": {
        "extensions": [
          ".stk"
        ]
      },
      "target": {
        "kind": "token",
        "section": "stackable",
        "index": 2
      },
      "annotation": {
        "title": "权重",
        "type": "text"
      },
      "group": "booster"
    },
    {
      "id": "booster·道具数量",
      "match": {
        "extensions": [
          ".stk"
        ]
      },
      "target": {
        "kind": "token",
        "section": "stackable",
        "index": 3
      },
      "annotation": {
        "title": "数量",
        "type": "text"
      },
      "group": "booster"
    },
    {
      "id": "booster·装备权重",
      "match": {
        "extensions": [
          ".stk"
        ]
      },
      "target": {
        "kind": "token",
        "section": "etc",
        "index": 2
      },
      "annotation": {
        "title": "权重",
        "type": "text"
      },
      "group": "booster"
    },
    {
      "id": "booster·装备数量",
      "match": {
        "extensions": [
          ".stk"
        ]
      },
      "target": {
        "kind": "token",
        "section": "etc",
        "index": 3
      },
      "annotation": {
        "title": "数量",
        "type": "text"
      },
      "group": "booster"
    },
    {
      "id": "global.cool_time",
      "match": {},
      "target": {
        "kind": "section",
        "section": "cool time"
      },
      "annotation": {
        "title": "冷却时间 ms",
        "type": "text"
      },
      "group": "global"
    },
    {
      "id": "skill.levelup",
      "match": {},
      "target": {
        "kind": "token",
        "section": "skill levelup",
        "index": 1,
        "recordTokens": 3
      },
      "annotation": {
        "title": "技能",
        "type": "reference",
        "relation": "技能"
      },
      "group": "skill"
    },
    {
      "id": "skill.dataup",
      "match": {},
      "target": {
        "kind": "token",
        "section": "skill data up",
        "index": 1,
        "recordTokens": 7
      },
      "annotation": {
        "title": "技能",
        "type": "reference",
        "relation": "技能"
      },
      "group": "skill"
    },
    {
      "id": "global.input",
      "match": {},
      "target": {
        "kind": "token",
        "section": "input",
        "index": 0
      },
      "annotation": {
        "title": "未知ID",
        "type": "reference",
        "relation": "道具"
      },
      "group": "global"
    },
    {
      "id": "global.output",
      "match": {},
      "target": {
        "kind": "token",
        "section": "output",
        "index": 0
      },
      "annotation": {
        "title": "未知ID",
        "type": "reference",
        "relation": "物品"
      },
      "group": "global"
    },
    {
      "id": "global.icon",
      "match": {},
      "target": {
        "kind": "token",
        "section": "icon",
        "index": 0,
        "recordTokens": 2,
        "imageIndexToken": 1
      },
      "annotation": {
        "title": "图标",
        "type": "image",
        "inlineImage": true
      },
      "group": "global"
    },
    {
      "id": "global.field image",
      "match": {},
      "target": {
        "kind": "token",
        "section": "field image",
        "index": 0,
        "recordTokens": 2,
        "imageIndexToken": 1
      },
      "annotation": {
        "title": "图标",
        "type": "image",
        "inlineImage": true
      },
      "group": "global"
    },
    {
      "id": "global.icon mark",
      "match": {},
      "target": {
        "kind": "token",
        "section": "icon mark",
        "index": 0,
        "recordTokens": 2,
        "imageIndexToken": 1
      },
      "annotation": {
        "title": "图标",
        "type": "image",
        "inlineImage": true
      },
      "group": "global"
    }
  ]
}
