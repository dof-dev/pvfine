{
  "version": 1,
  "description": "pvfine built-in annotation rules",
  "fields": [
    {
      "id": "equ.name",
      "match": {
        "extensions": [
          ".equ"
        ]
      },
      "target": {
        "kind": "token",
        "section": "name",
        "index": 0
      },
      "annotation": {
        "title": "名称",
        "type": "text"
      },
      "preview": {
        "provider": "equ",
        "role": "name",
        "group": "header",
        "order": 10,
        "format": "text"
      }
    },
