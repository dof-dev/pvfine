{
  "version": 1,
  "description": "pvfine built-in script rendering rules",
  "rules": [
    {
      "id": "file.lst",
      "match": {
        "extensions": [
          ".lst"
        ]
      },
      "target": {
        "kind": "file"
      },
      "format": {
        "tokensPerLine": 2
      }
    },
    {
      "id": "section.world-drop",
      "match": {},
      "target": {
        "kind": "section",
        "section": "world drop"
      },
      "format": {
        "tokensPerLine": 2,
        "standaloneValues": [
          -1
        ]
      }
    },
    {
      "id": "section.independent-drop",
      "match": {},
      "target": {
        "kind": "section",
        "section": "independent drop"
      },
      "format": {
        "tokensPerLine": 17,
        "nestedSections": [
          "list"
        ]
      }
    },
    {
      "id": "section.list",
      "match": {},
      "target": {
        "kind": "section",
        "section": "list"
      },
      "format": {
        "tokensPerLine": 2
      }
    },
    {
      "id": "section.skill-data-up",
      "match": {},
      "target": {
        "kind": "section",
        "section": "skill data up"
      },
      "format": {
        "tokensPerLine": 7
      }
    },
    {
      "id": "section.skill-levelup",
      "match": {},
      "target": {
        "kind": "section",
        "section": "skill levelup"
      },
      "format": {
        "tokensPerLine": 3
      }
    },
    {
      "id": "section.skill",
      "match": {},
      "target": {
        "kind": "section",
        "section": "skill"
      },
      "format": {
        "tokensPerLine": 7,
        "offset": 1
      }
    },
    {
      "id": "section.level info",
      "match": {},
      "target": {
        "kind": "section",
        "section": "level info"
      },
      "format": {
        "tokensPerLine": 1,
        "offset": 1,
        "tokensPerLineIndex": 0
      }
    },
    {
      "id": "section.input item",
      "match": {},
      "target": {
        "kind": "section",
        "section": "input item"
      },
      "format": {
        "tokensPerLine": 2
      }
    },
    {
      "id": "section.output item",
      "match": {},
      "target": {
        "kind": "section",
        "section": "output item"
      },
      "format": {
        "tokensPerLine": 2
      }
    },
    {
      "id": "section.basis of rarity dicision.hell",
      "match": {
        "glob": "etc/itemdropinfo_monster_hell.etc"
      },
      "target": {
        "kind": "section",
        "section": "basis of rarity dicision"
      },
      "format": {
        "tokensPerLine": 7,
        "tokensPerLineByVersion": {
          "90US": 7,
          "90CN": 7,
          "TW": 6,
          "100CN": 8,
          "110US": 9,
          "115CN": 9
        },
        "offset": 1
      }
    },
    {
      "id": "section.basis of rarity dicision",
      "match": {},
      "target": {
        "kind": "section",
        "section": "basis of rarity dicision"
      },
      "format": {
        "tokensPerLine": 7,
        "tokensPerLineByVersion": {
          "90US": 7,
          "90CN": 7,
          "TW": 6,
          "100CN": 8,
          "110US": 9,
          "115CN": 9
        }
      }
    },
    {
      "id": "section.equipment part set",
      "match": {},
      "target": {
        "kind": "section",
        "section": "equipment part set"
      },
      "format": {
        "tokensPerLine": 4,
        "offset": 3
      }
    },
    {
      "id": "etc.upgrade.table",
      "match": {
        "glob": "etc/upgrade.etc"
      },
      "target": {
        "kind": "section",
        "section": "table"
      },
      "format": {
        "tokensPerLine": 17
      }
    },
    {
      "id": "etc.upgrade.table-type",
      "match": {
        "glob": "etc/upgrade.etc"
      },
      "target": {
        "kind": "section",
        "section": "table type"
      },
      "format": {
        "tokensPerLine": 24,
        "offset": 1
      }
    },
    {
      "id": "etc.upgrade.safe-upgrade",
      "match": {
        "glob": "etc/upgrade.etc"
      },
      "target": {
        "kind": "section",
        "section": "safe upgrade"
      },
      "format": {
        "tokensPerLine": 8
      }
    },
    {
      "id": "etc.amplify.table",
      "match": {
        "glob": "etc/amplifyupgrade.etc"
      },
      "target": {
        "kind": "section",
        "section": "table"
      },
      "format": {
        "tokensPerLine": 17
      }
    },
    {
      "id": "etc.amplify.table-type",
      "match": {
        "glob": "etc/amplifyupgrade.etc"
      },
      "target": {
        "kind": "section",
        "section": "table type"
      },
      "format": {
        "tokensPerLine": 24,
        "offset": 1
      }
    },
    {
      "id": "etc.amplify.safe-upgrade",
      "match": {
        "glob": "etc/amplifyupgrade.etc"
      },
      "target": {
        "kind": "section",
        "section": "safe upgrade"
      },
      "format": {
        "tokensPerLine": 8
      }
    },
    {
      "id": "etc.forge.table",
      "match": {
        "glob": "etc/upgrade_separate.etc"
      },
      "target": {
        "kind": "section",
        "section": "table"
      },
      "format": {
        "tokensPerLine": 4,
        "tokensPerLineByVersion": {
          "115CN": 6
        }
      }
    },
    {
      "id": "etc.forge.item-weights-by-grade",
      "match": {
        "glob": "etc/upgrade_separate.etc"
      },
      "target": {
        "kind": "section",
        "section": "item weights by grade"
      },
      "format": {
        "tokensPerLine": 3
      }
    },
    {
      "id": "etc.forge.item-weights-by-grade-100lv",
      "match": {
        "glob": "etc/upgrade_separate.etc"
      },
      "target": {
        "kind": "section",
        "section": "item weights by grade 100lv"
      },
      "format": {
        "tokensPerLine": 3
      }
    },
    {
      "id": "etc.forge.item-weights-by-rarity",
      "match": {
        "glob": "etc/upgrade_separate.etc"
      },
      "target": {
        "kind": "section",
        "section": "item weights by rarity"
      },
      "format": {
        "tokensPerLine": 9
      }
    },
    {
      "id": "etc.forge.item-weights-by-rarity-100lv",
      "match": {
        "glob": "etc/upgrade_separate.etc"
      },
      "target": {
        "kind": "section",
