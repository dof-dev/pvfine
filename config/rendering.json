        "glob": "etc/upgrade_separate.etc"
      },
      "target": {
        "kind": "section",
        "section": "stat weights by rarity"
      },
      "format": {
        "tokensPerLine": 9
      }
    },
    {
      "id": "etc.forge.separate-upgrade-effect",
      "match": {
        "glob": "etc/upgrade_separate.etc"
      },
      "target": {
        "kind": "section",
        "section": "separate upgrade effect"
      },
      "format": {
        "tokensPerLine": 6
      }
    },
    {
      "id": "etc.forge.activestatus-upgrade-dungeon",
      "match": {
        "glob": "etc/upgrade_separate.etc"
      },
      "target": {
        "kind": "section",
        "section": "activestatus upgrade dungeon"
      },
      "format": {
        "tokensPerLine": 1
      }
    },
    {
      "id": "etc.forge.activestatus-upgrade-pvp",
      "match": {
        "glob": "etc/upgrade_separate.etc"
      },
      "target": {
        "kind": "section",
