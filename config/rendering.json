      },
      "format": {
        "tokensPerLine": 8
      }
    },
    {
      "id": "etc.forge.genuine-buffer-option-apply-weapon",
      "match": {
        "glob": "etc/upgrade_separate.etc"
      },
      "target": {
        "kind": "section",
        "section": "genuine buffer option apply weapon"
      },
      "format": {
        "tokensPerLine": 9
      }
    },
    {
      "id": "user.rule.aaf15bba-9653-41ae-b16c-17f4fb640e66",
      "match": {
        "extensions": [
          ".stk"
        ]
      },
      "target": {
        "kind": "section",
        "section": "cera"
      },
      "format": {
        "tokensPerLine": 3,
        "offset": 1
      }
    }
  ]
}
