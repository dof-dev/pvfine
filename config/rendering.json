{
  "version": 1,
  "description": "pvfine built-in script rendering rules",
  "rules": [
    {
      "id": "file.lst",
      "match": {
        "extensions": [
          ".lst"
        ]
      },
      "target": {
        "kind": "file"
      },
      "format": {
        "tokensPerLine": 2
      }
    },
    {
      "id": "section.skill-data-up",
      "match": {},
      "target": {
        "kind": "section",
        "section": "skill data up"
      },
      "format": {
        "tokensPerLine": 7
      }
    },
    {
      "id": "section.skill-levelup",
      "match": {},
      "target": {
        "kind": "section",
        "section": "skill levelup"
      },
      "format": {
        "tokensPerLine": 3
      }
    },
    {
      "id": "section.skill",
      "match": {},
      "target": {
        "kind": "section",
        "section": "skill"
      },
      "format": {
        "tokensPerLine": 7,
        "offset": 1
      }
    },
    {
      "id": "section.level info",
      "match": {},
      "target": {
        "kind": "section",
        "section": "level info"
      },
      "format": {
        "tokensPerLine": 1,
        "offset": 1,
        "tokensPerLineIndex": 0
      }
    },
    {
      "id": "section.input item",
      "match": {},
      "target": {
        "kind": "section",
        "section": "input item"
      },
      "format": {
        "tokensPerLine": 2
      }
    },
    {
      "id": "section.output item",
      "match": {},
      "target": {
        "kind": "section",
        "section": "output item"
      },
      "format": {
        "tokensPerLine": 2
      }
    },
    {
      "id": "section.basis of rarity dicision.hell",
      "match": {
        "glob": "etc/itemdropinfo_monster_hell.etc"
      },
      "target": {
        "kind": "section",
        "section": "basis of rarity dicision"
      },
      "format": {
        "tokensPerLine": 7,
        "offset": 1
      }
    },
    {
      "id": "section.basis of rarity dicision",
      "match": {},
      "target": {
        "kind": "section",
        "section": "basis of rarity dicision"
      },
      "format": {
        "tokensPerLine": 7
      }
    }
  ]
}